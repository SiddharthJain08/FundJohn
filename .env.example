# === LLM ===
ANTHROPIC_API_KEY=your_key_here

# === SP-1 (2026-05-22): Alpaca AAT Plus provider cutover ===
ALPACA_NEWS_INGEST=1
ALPACA_OPTIONS_ARCHIVE=1
ALPACA_DATA_TIER=algo_trader_plus
# ALPACA_SOAK_MODE_UNTIL=YYYY-MM-DD       # tightened alert thresholds 7d post-deploy
# FMP_FORWARD_EARNINGS_PROBE=1            # one-shot at PR-build; remove after operator confirms which path

# === DATA (Tier 1 — Primary) ===
FMP_API_KEY=your_key_here
# REMOVED in SP-1 (2026-05-22): POLYGON_API_KEY — Alpaca AAT Plus is now P1 for equity/options data
# REMOVED in SP-1 (2026-05-22): ALPHA_VANTAGE_API_KEY — AV purged from data stack
TAVILY_API_KEY=your_key_here

# === DATA (Tier 2 — Fallback) ===
# Yahoo Finance — no key needed (yfinance)

# === FILINGS ===
SEC_USER_AGENT=OpenClaw/1.0 (your_email@example.com)

# === DATABASE ===
POSTGRES_URI=postgresql://openclaw:password@localhost:5432/openclaw
REDIS_URL=redis://localhost:6379

# === DISCORD ===
DISCORD_BOT_TOKEN=your_token_here
ALLOWED_CHANNEL_IDS=
ALLOWED_USER_IDS=

# === RUNTIME ===
CLAUDE_BIN=/usr/local/bin/claude-bin
CLAUDE_UID=1001
CLAUDE_GID=1001
CLAUDE_HOME=/home/claudebot
OPENCLAW_DIR=/root/openclaw

# === SANDBOX ===
SANDBOX_TYPE=local
# DAYTONA_API_KEY=your_key_here  # if using Daytona cloud sandboxes

# === MEMORY RETRIEVAL (pgvector + Voyage embeddings) ===
# Embed pipeline writes to memory_chunks (migration 054). Retrieval middleware
# (workspace-context.js) prefers retrieval when MEMORY_RETRIEVAL=on AND chunks
# exist; else falls back to wholesale memory/*.md injection. See
# /root/.claude/plans/go-through-this-deep-wand.md §9 for the runbook.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
MEMORY_RETRIEVAL=          # set to 'on' after backfill populates memory_chunks
MEMORY_RETRIEVAL_K=8       # top-K chunks per retrieval (optional override)

# === SP-2 Phase A — Universe-slice machinery ===
OPENCLAW_UNIVERSE_RESOLVER=1               # kill switch; 0 falls back to legacy hardcoded universe
UNIVERSE_RESOLVER_MIN_LIVE_TICKERS=200     # doctor + system_check floor for the live-strategy union
OPENCLAW_BACKFILL_5Y_CHECKPOINT_DIR=/root/openclaw/data/.checkpoints/backfill_5y  # Phase B path

# === SP-2 Phase B — 5y backfill ===
OPENCLAW_BACKFILL_5Y_ACTIVE=0              # operator opens before running scripts/backfill_universe_5y.py
OPENCLAW_BACKFILL_ALLOW_OVERWRITE=0        # set =1 only for v2+ source_tag quarantine recovery
BACKFILL_FMP_CONCURRENCY=4                 # parallel FMP requests during STAGE
BACKFILL_FMP_INTERVAL_MS=200               # min ms between FMP requests per worker
BACKFILL_ALPACA_CONCURRENCY=12             # parallel Alpaca requests during STAGE
BACKFILL_ALPACA_INTERVAL_MS=80             # min ms between Alpaca requests per worker
DISCORD_BACKFILL_LOG_WEBHOOK=              # #backfill-log webhook for per-chunk + daily digest

# === SP-2 Phase C — Mastermind universe-recs (Sat 20:00 ET) ===
OPENCLAW_UNIVERSE_RECS=0
UNIVERSE_RECS_WEEKLY_BUDGET_USD=400
UNIVERSE_RECS_PER_STRATEGY_BUDGET_USD=8
UNIVERSE_RECS_LOOKBACK_DAYS=365
UNIVERSE_RECS_CANDIDATE_SET_VERSION=v1
DISCORD_UNIVERSE_RECS_CHANNEL=universe-recs

# === SP-2 Phase D — Predicate-at-mint (PaperHunter infers universe slice; default ON) ===
# Code treats absent as OFF — the live VPS .env must include this line to activate Phase D.
OPENCLAW_PHASE_D_PREDICATE_AT_MINT=1

# === SP-3 — Asset-class expansion ===
# SP-3 asset-class expansion. Default-OFF kill-switch: when unset/0, every
# strategy is sized down the equity (notional) path regardless of its declared
# instrument_class. Flip to 1 after soak to enable per-class sizing routing.
OPENCLAW_INSTRUMENT_CLASS_ROUTING=0

# === SP-3.1 Phase B — Crypto regime detector ===
# Enable the 24/7 crypto regime detector (hourly cron + detector). Default OFF.
# Produces crypto_regime_latest.json + crypto_regime_states only; does NOT
# trigger redeploys or gate strategies (Phase C).
OPENCLAW_CRYPTO_REGIME=0

# === SP-3.1 Phase C — Crypto redeploy ===
# Enable the dedicated crypto redeploy: a confirmed crypto regime transition
# spawns a crypto-only rebalance (margin-funded, NEVER touches equity; next
# daily cycle corrects total leverage). Default OFF. Inert until a live crypto
# strategy exists (Phase D). ACTIVATION REQUIRES BOTH GATES: live crypto order
# submission also needs OPENCLAW_INSTRUMENT_CLASS_ROUTING=1 (the executor only
# routes crypto orders when that is ON) — else orders are sized but SKIP at submit.
OPENCLAW_CRYPTO_REDEPLOY=0

# Executor day-trading-buying-power guard. Default ON (absent = ON). The daily
# executor skips opening orders that exceed available buying power
# (min(daytrading_buying_power, regt_buying_power)) — highest-conviction first,
# the rest recorded as skipped_dtbp — instead of letting Alpaca 403-reject the
# tail. Closes/covers are never guarded. Set =0 to disable (executor reverts to
# submitting the full sized set). See docs/superpowers/specs/2026-05-27-executor-dtbp-guard-design.md
OPENCLAW_DTBP_GUARD=1
