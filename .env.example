# ── Alpaca Paper Trading ──────────────────────────────────────────────────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Trusted peer agents — GOD BOT and Chappie Bot Discord IDs
TRUSTED_BOT_IDS=1492085221401690334,1489562602311909406

# Mintlify — REST API for triggering deploys.
#   MINTLIFY_PROJECT_ID : project identifier (from the share link / dashboard). No prefix.
#   MINTLIFY_ADMIN_KEY  : server-side admin API key (prefixed `mint_`). Paste when available.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
MEMORY_RETRIEVAL=on
ALPACA_LIVE_TRADE=false   # paper-trading, explicit (alpaca CLI integration)

# Tier 3: enable CycleAbort routing on rc=2 (auth/config errors)
OPENCLAW_STRICT_EXIT_CODES=1

# Tier 3: enable alpaca_replace_stop.py to issue live broker order replaces.
# 2026-04-28 monitoring: dry-run showed 4 reasonable +2% stop tightens for S21
# (NKE/GIS/CPB/ISRG). NB: bracket legs from earlier in the cycle expire daily
# (day TIF), so replace_stop_for_coid currently returns lookup_failed for these.
# Real fix is a separate follow-up — submit standalone stop orders that survive
# overnight. Flag is on so the wiring is exercised + alerts surface mismatches.
OPENCLAW_ALPACA_LIVE_REPLACE=1

# Liquidate-on-regime-change (src/execution/regime_liquidator.py). When the
# 9 AM ET regime classifier writes regime_latest.json with prior_state != state,
# the liquidator cancels every open OpenClaw order (COID prefix 'AX') and
# market-closes every OpenClaw symbol (OPG pre-market, day TIF in RTH). The
# 10 AM trading cycle then proceeds normally and rotates into fresh signals
# for the new regime. Set to 1 to enable live broker action; unset for dry-run.
OPENCLAW_ALPACA_LIVE_LIQUIDATE=1

# Long-lived OAuth token from setup-token (added 2026-05-12). Rotate from console.anthropic.com if exposed.
CLAUDE_CODE_OAUTH_TOKEN=

# Phase 3 LIVE flip — regime_blended_sizer becomes production trade step (operator-driven 2026-05-12)
OPENCLAW_REGIME_BLENDED_LIVE=1

# OPENCLAW_SHARPE_CADENCE_SIZER removed 2026-05-21 — sharpe-cadence is
# now hardcoded as the sole sizer path (regime_blended_sizer.size_positions).
OPENCLAW_AUTO_DEMOTE=1
OPENCLAW_DATAHUB_HANDOFF=1

# Regime-redeploy LIVE flags (2026-05-19, Phase 5 cutover)
OPENCLAW_INTRADAY_HMM_LIVE=1
OPENCLAW_REDEPLOY_EXTENDED_HOURS=0
# Intraday 15-min cadence + tick-1 prefetch / tick-3 data-ready gate (2026-06-09; inert until next RTH open)
OPENCLAW_INTRADAY_15MIN_PREFETCH=1

# F3 — Mastermind self-critique loop (2026-05-20). Saturday 18:30 ET critique
# fan-out (3 Sonnet critics) + 19:00 ET Opus synthesizer. position_recommender
# reads strategy_synthesis when present, falls back to original memo otherwise.
# When the critique timer is NOT yet installed, this gate still enables the
# fallback path inside position_recommender (no critiques → audit row with
# 'ALL_CRITICS_FAILED, defaulted to original', adjusted = original).
OPENCLAW_MEMO_CRITIQUE=1
OPENCLAW_MODEL_TIERING=1

# D1 — sentiment ingestion step (2026-05-20). When set, pipeline_orchestrator
# inserts the `sentiment` step between `collect` and `signals`, running
# src/pipeline/run_sentiment_step.py daily. Writes ticker_sentiment_daily
# + data/master/sentiment.parquet. Sources: Reddit RSS + StockTwits +
# FinBERT-over-market_news. Live smoke 2026-05-20 produced 79 ticker
# rows/cycle (35 social, 3 stocktwits-tagged, 61 news-scored).
# Confirmer-side gate flipped LIVE 2026-05-22 21:30 UTC after SP-1 Task 15a
# closed the upstream gap (market_news constraint drift + dual-write fixed).
# When ON, tradejohn-confirmer.md's `## Sentiment & News Inputs` section is
# included in the prompt and per-proposal `sentiment` payloads are sent to
# the model. Coverage soak begins now; revert if cancel rate > 5%/cycle.
OPENCLAW_SENTIMENT_INGEST=1
OPENCLAW_CONFIRMER_SENTIMENT=1

# E1 — LangGraph orchestrator migration (2026-05-20). When set, the 10am
# cron job and scripts/redeploy_pipeline.py route through the new
# src/agent/graphs/daily-cycle.js StateGraph instead of the legacy
# src/execution/pipeline_orchestrator.py. Resumability + dashboard
# observability via PostgresSaver checkpoints + traceBus emissions.
#
# Unset (or set to anything other than '1') = legacy path.
# Default OFF until operator validates the new graph in production
# (see docs/superpowers/specs/2026-05-20-e1-langgraph-orchestrator-migration-design.md §6.2).
# OPENCLAW_LANGGRAPH_ORCHESTRATOR=1

# SP-1 provider cutover gates (added 2026-05-22)
ALPACA_NEWS_INGEST=1
ALPACA_OPTIONS_ARCHIVE=1
ALPACA_DATA_TIER=algo_trader_plus
ALPACA_SOAK_MODE_UNTIL=2026-05-30

# E1 LangGraph orchestrator — flipped LIVE 2026-05-22 by operator
OPENCLAW_LANGGRAPH_ORCHESTRATOR=1
OPENCLAW_BACKFILL_5Y_ACTIVE=1

# SP-2 Phase C + D activated 2026-05-25
# OPENCLAW_UNIVERSE_RECS=1  # disabled 2026-06-06: legacy universe-recs superseded by SP-7 Phase B tier ladder (operator-approved skip)
OPENCLAW_PHASE_D_PREDICATE_AT_MINT=1

# SP-3.1 Phase D activation 2026-05-26 — crypto live (operator-approved)
OPENCLAW_INSTRUMENT_CLASS_ROUTING=1
OPENCLAW_CRYPTO_REGIME=1
OPENCLAW_CRYPTO_REDEPLOY=1

# Strategy orthogonalization activation 2026-05-29 (operator-approved; all gates ON)
# NOTE: ORTHO_SHADOW is inert while FOLD/CORR_WEIGHT are ON (shadow guard = NOT(FOLD or CORR_WEIGHT)).
OPENCLAW_STRATEGY_FOLD=1
OPENCLAW_STRATEGY_CORR_WEIGHT=1
OPENCLAW_STRATEGY_ORTHO_SHADOW=1
OPENCLAW_STRATEGY_SIZE_SCALAR=1
# Block-stacked brackets (Tier-3) flipped LIVE 2026-05-29 (operator-approved full flip).
# Stacks take-profit (capped 3x) across uncorrelated blocks, keeps tightest stop.
# Deployed onto feat/dashboard-backtest-metrics + johnbot restarted. When set, the
# bracket-stack shadow log goes silent (guard = ORTHO_SHADOW and not BRACKET_STACK).
OPENCLAW_STRATEGY_BRACKET_STACK=1
# √cadence-normalized stops/TPs flipped LIVE 2026-06-09 (operator-approved full flip, no dry-run).
# Each contributing strategy's stop/t1/t2 gap-from-entry is shrunk by 1/√cadence_days at
# candidate-construction (mirrors daily_weight=sharpe/√cadence) so corroborated brackets are
# horizon-consistent with the daily-rebalanced book. Combine (min-stop/capped-sum-TP) unchanged;
# backtest + recs unchanged. Takes effect only after johnbot restart (env inherited at startup).
# Rollback: set to 0 + restart johnbot. Spec: docs/superpowers/specs/2026-06-09-cadence-normalized-stops-design.md
OPENCLAW_STRATEGY_CADENCE_STOP_NORM=1
# (retired 2026-06-23) Stacked take-profit is now MAX-of-blocks, hardcoded in
# bracket_stacking.stacked_bracket (tp_total = the largest single block take, NOT the
# cumulative sum -> a reachable target that fires, so winners get banked instead of
# riding into reversals). The OPENCLAW_BRACKET_STACK_TP_CAP_MULT gate is removed.
# Backtest 738 trades 06-23: per-trade Sharpe 0.320 (MAX) vs 0.313 (old uncapped sum);
# take fires 41% vs 16%; bankable-peak round-trips to <=0 9% vs 21%. Rollback = git revert.

# SP-4: activate instrument-class-at-mint — origination tags option/etp/crypto (2026-05-27)
OPENCLAW_SP4_INSTRUMENT_CLASS_AT_MINT=1

# Close-execution rollout — SUPERSEDED by SP-6 Phase A 2026-06-01: CLOSE_EXEC_LIVE 1→0 (mutually exclusive with EOD flow)
OPENCLAW_CLOSE_EXEC_LIVE=0

# SP-6 Phase A — EOD→open execution ARMED 2026-06-01 (paper). compute@close[T] 16:15 ET → gate 9:15 → reconcile 9:28 → sizer 3:55 (T+1).
# Rollback: set the 4 EOD gates to 0 + restore OPENCLAW_CLOSE_EXEC_LIVE=1 + restart johnbot.
# Runbook: docs/superpowers/runbooks/2026-05-31-sp6-phase-a-rollout.md
OPENCLAW_EOD_SIGNAL_REGISTER=1
OPENCLAW_EOD_PREMARKET_GATE=1
OPENCLAW_EOD_RECONCILE=1
OPENCLAW_OPEN_CLOSE_MODE=opg_then_day
OPENCLAW_CLOSE_PROXY_SNAPSHOT=0

# Flatten-the-book on genuine zero-conviction (EOD lane only). Default-OFF kill-switch.
# When =1, a HEALTHY carried set (>= SIGNAL_SET_MIN_FLOOR=10 signals) that is FULLY
# rejected by the corr-conviction floor triggers a flatten of the whole broker book
# (orphan_close every held position) instead of silently HOLDing — the fix for the
# 2026-07 3-day silent trading halt (book held at ~14% gross). Fires ONLY on the EOD
# lane: OPENCLAW_EOD_RECONCILE=1 AND OPENCLAW_INTRADAY_REDEPLOY!=1 (an intraday
# redeploy inherits EOD_RECONCILE=1, so the intraday exclusion is load-bearing —
# it must NOT liquidate on a momentary regime transition). Leave OFF (or unset) until
# the operator deliberately arms it; merging the code is inert while this is unset.
OPENCLAW_FLATTEN_ON_ZERO_CONVICTION=0

# Pre-market scanner + EDGAR ingester (flipped live 2026-05-28)
# Verdict: S12_SELL stays OFF per HOLD; premarket advisory + EDGAR ingest ON
OPENCLAW_PREMARKET_SCAN=1
OPENCLAW_EDGAR_8K_INGEST=1
# All 3 news systems (premarket scanner, EDGAR 8-K, D1 sentiment) route to
# #pre-market-alerts via databot persona (registered 2026-05-28).
OPENCLAW_PREMARKET_DISCORD_WEBHOOK_NAME=pre-market-alerts
OPENCLAW_EDGAR_DISCORD_WEBHOOK_NAME=pre-market-alerts
OPENCLAW_SENTIMENT_DISCORD_WEBHOOK_NAME=pre-market-alerts
# OPENCLAW_PREMARKET_CONFIRMER and OPENCLAW_PREMARKET_AUTOCLOSE intentionally absent (advisory-only)
# OPENCLAW_S12_SELL_CLUSTER intentionally absent (HOLD per v3 backtest)

# S15 — Opportunistic Insider Cluster SHORT (NEW, flipped live 2026-05-28)
# v13 verdict: Sharpe +1.6894 / MaxDD 4.81% / 477 trades / hit 0.64
# Promoted via lifecycle (paper → candidate → live, guards passed)
# Per-regime weights: HIGH_VOL 12.55 / LOW_VOL 8.08 / TRANSITIONING 0.64
# Separate strategy from S12_insider BUY (S15 = SHORT side, distinct module)
OPENCLAW_S15_INSIDER_OPPORTUNISTIC=1
OPENCLAW_BACKTEST_COUPLED_RECS=1
# OPENCLAW_ENGINE_UNIVERSE_CLAMP removed 2026-06-28 (SP-7 §6 clamp DELETION — resolver is now sole universe authority)
OPENCLAW_B1_SHADOW=1
OPENCLAW_UNIVERSE_AUTOADOPT=1  # SP-7 Phase B: auto-adopt ladder change-recs (ΔSharpe>=0.10 vs current tier; operator directive 2026-06-07)

# SP-7 Phase C — shadow parity gate (OPENCLAW_LIVE_UNIVERSE_SHADOW) removed 2026-06-28 (SP-7 §6):
# resolver-vs-clamp sidecar has nothing to diff post-clamp-deletion. universe_shadow_parity TABLE kept (audit history).

# SP-7 Phase C — C2 collector envelope (runbook §4, flipped 2026-06-13 after ladder-20260607
# drained: last_full_run=2026-06-13, 20 broad-tier adoptions landed). Widens PRICE fetch to the
# no-floor resolver envelope (5228) and FUNDAMENTALS(FMP)/INSIDER(EDGAR) scope to the floored
# adopted-union (4679), each UNIONed with config (never shrinks). Measured net-new vs the existing
# config-5149 baseline: +465 Alpaca price names (unbounded quota), +2 FMP & +2 EDGAR names (vs
# 250/day quota) — NOT the inert-503 story, the quota burn is negligible because config is already
# wide. All failure modes fail-open to the config list (Redis miss / resolver timeout / OOM).
# Rollback: set =0 + `systemctl --user restart johnbot`. Must soak >=1 trading day before C1.
# ACTIVE — flipped LIVE 2026-06-13 (operator-authorized). Rollback: re-comment + restart johnbot.
OPENCLAW_COLLECTOR_RESOLVER_ENVELOPE=1

# SP-7 Phase C — C1 engine per-strategy universes (runbook §5, flipped LIVE 2026-06-21, operator-authorized).
# Engine builds each strategy's universe via UniverseResolver (build_strategy_universes); clamp superseded.
# Prereqs verified at flip: universe_shadow_parity PASS (3 clean days 06-17/18/19; 06-19=Juneteenth holiday
# cycle, parity is structural so valid), universe_tier_coherence PASS, ladder-20260607 drained, 20 adoptions
# decided, C2 ON >1 trading day (gate live in-process, collection healthy; envelope inert under parquet-primary).
# §6 clamp DELETION done 2026-06-28: the sp500 clamp is GONE, so adopted tiers (r1000/r3000/liquid ⊃ sp500) now
# widen the live universe for real (per-strategy union 620→5180; memory-validated +203MB peak, 3078→3281MB, signals
# 958→970). The resolver is the SOLE universe authority. Fails open to the shared (unclamped) fallback on build error.
# OBSERVE = Mon 2026-06-22 10:00 ET cycle: log `live-universe ON: union N tickers, 67 strategies, 0 fail-open`,
# signal count sane vs 06-15..19 baseline (536-752), NO empty-universe warnings, capture signals-step PEAK RSS.
# ⚠ MEMORY: Mon 10 ET resolver CoverageIndex (~1.65 GB) must not co-reside with the concurrent equity-calendar
# backtest (/tmp/panel_one.py ~2.28 GB) on this 8 GB no-swap box — OOM-SIGKILL risk. Rollback: =0 + restart johnbot.
OPENCLAW_LIVE_UNIVERSE_RESOLVER=1

# SP-7 Phase C — C3 sentiment resolver universe (runbook §7). STAGED 2026-06-21, NOT yet flipped.
# When =1, the daily sentiment step (run_sentiment_step.py:_widen_with_resolver) UNIONs the resolver
# adopted-union (live+candidate) into the 3-source sentiment universe. Fail-open (sentiment never dies
# on resolver issues). Widened sentiment feeds the TradeJohn per-ticker confirmer (LOW_VOL/TRANSITIONING
# veto/scale) + the news-sentiment L/S strategy via aux['sentiment'] — so newly-covered tickers can see
# bounded, fail-open execution nudges (NOT cosmetic; this is why it's kept a SINGLE clean variable).
# DELTA today = BOUNDED, likely modest, NOT zero: sentiment baseline current_universe()=5166 (already ⊇
# universe_config active 5149) vs resolver floored adopted-union ~4679 (recorded 06-13, don't recompute —
# 1.65GB build). |baseline|>|union| does NOT imply union⊆baseline (C2 showed +465 net-new vs config at
# no-floor). Exact N is revealed by the first gated run's log `sentiment: resolver universe +N`.
# ACTIVATION needs a johnbot RESTART (subprocess inherits johnbot's frozen process.env — daily_cycle_node.js:53
# `{...process.env}`, no per-step dotenv reload; a bare .env edit does NOT propagate). Restart triggers the
# 2.7GB startup sync_data_ledger.py → DO NOT restart while the equity-calendar backtest sweep (/tmp/panel_one.py
# ~1.6-2.3GB) is running (OOM thrash, see ERR-20260621-001). First gated sentiment run also builds its OWN
# ~1.65GB CoverageIndex (runbook §7 OOM note).
# FLIP WHEN: (a) calendar sweep done AND (b) Mon 06-22 C1 observe returns clean — then uncomment + restart in a
# memory lull → first clean single-variable C3 run = Tue 06-23 cycle. Rollback: re-comment + restart johnbot.
# AUTOMATED: user timer `sp7-c3-flip.timer` fires Tue 2026-06-23 12:00 UTC → scripts/sp7_c3_guarded_flip.py
# verifies all of the above (C1 still live, Mon signals sane, no abort/OOM, no heavy proc, >=4500MB free) then
# uncomments THIS line + restarts johnbot; aborts+alerts #data-alerts on any failed guard. Disarm: `systemctl
# --user disable --now sp7-c3-flip.timer`. journal: `journalctl --user -u sp7-c3-flip`.
# NOTE: the sibling gate OPENCLAW_OPTIONS_ARCHIVE_RESOLVER_UNIVERSE stays OFF (runbook §7 DO-NOT-FLIP — all
# options_eligible rows FALSE until the Phase D eligibility producer ships; flipping = no-op + 1 warning/run).
OPENCLAW_SENTIMENT_RESOLVER_UNIVERSE=1

# 2026-06-16 — Faithful bracket recording + latest-run reattach + after-hours TPs (W1/W2/W3).
# Rollback per-gate: delete the line + restart johnbot (W1/W2) / disable timer (W3).
OPENCLAW_RECORD_PLACED_BRACKET=1
OPENCLAW_REATTACH_FROM_BROKER=1
OPENCLAW_AFTERHOURS_TP=1

