[Unit]
# Runs self-gated: if OPENCLAW_UNIVERSE_RECS != 1 the script prints "skipped"
# and exits 0 — safe to install at any time.
# Installed name: openclaw-universe-recs.service
Description=MastermindJohn — per-strategy universe recs (Saturday 20:00 ET)
After=network.target postgresql.service openclaw-strategy-review.service
PartOf=johnbot.service

[Service]
Type=oneshot
User=claudebot
Group=claudebot
EnvironmentFile=/root/openclaw/.env
WorkingDirectory=/root/openclaw
ExecStart=/usr/bin/node /root/openclaw/src/agent/curators/run_mastermind.js --mode universe-recs
StandardOutput=journal
StandardError=journal
# Calls Opus per-strategy (grid spawns + Opus) — allow up to 4 hours.
# Per-strategy cost: 4 CLI grid spawns (~5 min each) + 1 Opus call (~5 min) ≈ 25 min/strategy.
# 52 live strategies × ~25 min worst-case = ~21 h theoretical max, but most run faster.
# If even 4 h is routinely exceeded, consider batching a subset per Saturday run.
TimeoutStartSec=14400

[Install]
WantedBy=multi-user.target
