[Unit]
Description=Nightly (Tue-Fri 21:40 UTC) guarded rf flip check; the script disables this timer once applied

[Timer]
# Persistent=false: a boot must never replay a missed check into the trading day.
OnCalendar=Tue..Fri *-*-* 21:40:00 UTC
Persistent=false
AccuracySec=1min
Unit=openclaw-rf-flip.service

[Install]
WantedBy=timers.target
