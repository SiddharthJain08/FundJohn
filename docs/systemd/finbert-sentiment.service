[Unit]
Description=FinBERT-Tone sentiment scoring service (127.0.0.1:7872)
After=network.target

[Service]
Type=simple
User=claudebot
Group=claudebot
WorkingDirectory=/root/openclaw
ExecStart=/usr/local/bin/uvicorn src.services.finbert.server:app --host 127.0.0.1 --port 7872
Restart=on-failure
RestartSec=5

# Ensure HF cache is found in claudebot's home (model pre-warmed there)
Environment="HOME=/home/claudebot"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=finbert-sentiment

[Install]
WantedBy=multi-user.target
