[Unit]
Description=OpenClaw Phase 2D nightly — signal overlap + proposal outcomes
After=docker.service postgresql.service network.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/root/openclaw
EnvironmentFile=/root/openclaw/.env
Environment="PYTHONPATH=/root/openclaw/src"
ExecStart=/usr/bin/python3 /root/openclaw/scripts/regime_phase2d_nightly.py
StandardOutput=append:/root/openclaw/logs/regime_phase2d_nightly.log
StandardError=append:/root/openclaw/logs/regime_phase2d_nightly.log
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
