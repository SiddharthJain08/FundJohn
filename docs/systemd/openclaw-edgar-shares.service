[Unit]
Description=Weekly EDGAR shares-outstanding refresh (shares_outstanding.parquet, bounded slice)
After=network-online.target postgresql.service
Wants=network-online.target
OnFailure=openclaw-failure-notify@%n.service

[Service]
Type=oneshot
# User=root: matches every data/master/*.parquet writer (all root:root) and
# the root-owned SEC ticker->CIK cache — same reason as openclaw-edgar-8k@.
User=root
Group=root
WorkingDirectory=/root/openclaw
EnvironmentFile=/root/openclaw/.env
# --alpaca-active: the ~13.4k active tradable us_equity rows (7.1k carry a
# CIK). --max-tickers 2000: never-attempted first, then stalest by the fetch
# log, so the universe cycles every ~4 weeks inside the 13-week 10-Q cadence.
ExecStart=/usr/bin/python3 -m src.pipeline.backfillers.edgar_shares --alpaca-active --max-tickers 2000
StandardOutput=journal
StandardError=journal
# Network-bound (~4-8 MB companyfacts JSON per ticker, SEC-paced 0.12 s) and
# <200 MB RSS; yield to anything live on the 2-core/8 GB box.
Nice=19
OOMScoreAdjust=800
# Sizing (measured 2026-08-23): ~0.25-0.4 s fetch + parse + per-ticker parquet
# append + 0.12 s sleep ~= 0.7 s/ticker -> 2000 tickers ~= 25 min. 90 min is
# ~3x headroom. TimeoutStartSec is the REAL bound for a Type=oneshot unit
# (systemd 257 ignores RuntimeMaxSec= on oneshots — `systemd-analyze verify`
# says so). Appends are per ticker and the fetch log flushes every 100 names,
# so a kill here loses nothing.
TimeoutStartSec=5400

[Install]
WantedBy=multi-user.target
