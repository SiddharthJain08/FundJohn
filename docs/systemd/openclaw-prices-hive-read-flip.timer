[Unit]
Description=Nightly (Tue-Fri 21:55 UTC) guarded prices-hive read flip check; the script disables this timer once applied

[Timer]
# Persistent=false: a boot must never replay a missed check into the trading day.
OnCalendar=Tue..Fri *-*-* 21:55:00 UTC
Persistent=false
AccuracySec=1min
Unit=openclaw-prices-hive-read-flip.service

[Install]
WantedBy=timers.target
