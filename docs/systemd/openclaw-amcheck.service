[Unit]
Description=OpenClaw — nightly btree index integrity sweep (amcheck; LRN-20260604-003)
After=network.target postgresql.service

[Service]
Type=oneshot
User=claudebot
Group=claudebot
EnvironmentFile=/root/openclaw/.env
WorkingDirectory=/root/openclaw
Nice=19
ExecStart=/usr/bin/python3 /root/openclaw/scripts/nightly_amcheck.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=300
# Non-PASS exit codes (1 WARN / 2 FAIL) are the alert signal, not a unit
# failure worth systemd state churn — the script posts to #data-alerts itself.
SuccessExitStatus=1 2

[Install]
WantedBy=multi-user.target
