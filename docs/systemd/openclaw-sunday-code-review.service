# Split out of openclaw-sunday-research-code (W4-5, 2026-06-30) so the MasterMind
# (Opus) candidate code-review has its own independent 2h timeout and cannot be
# starved by the finisher's 4h budget. Root cause: saturday_brain_finisher was
# missing process.exit(0), causing the oneshot to hang until the 4h
# TimeoutStartSec killed it — the second ExecStart (this review) never ran from
# Jun-14 until the W4-1 exit(0) fix. This split is defense-in-depth.
# REPORT-ONLY: writes the --out markdown; no strategy files are modified.
[Unit]
Description=Sunday MasterMind candidate code-review (report-only)
After=network-online.target postgresql.service
Wants=network-online.target
PartOf=johnbot.service
OnFailure=openclaw-failure-notify@%n.service

[Service]
Type=oneshot
User=claudebot
Group=claudebot
EnvironmentFile=/root/openclaw/.env
WorkingDirectory=/root/openclaw

# MasterMind (Opus) re-examines RECENT candidate implementations (incl. those
# coded by the 14:00 ET finisher slot) for IMPLEMENTATION-LOGIC bugs; candidates
# with <30 trades get a "bug vs genuinely rare" diagnosis. REPORT-ONLY (operator
# decision 2026-06-08: candidate gated auto-apply — apply→re-backtest→keep-if-
# non-regressing — is a separate, backtest-guarded upgrade). Best-effort: the
# leading '-' means a review hiccup does not fail the run. --limit 30 caps Opus
# calls to avoid runaway spend on weeks with many new candidates.
ExecStart=-/usr/bin/node /root/openclaw/src/agent/curators/mastermind_code_review.js --state candidate --recent-days 14 --include-low-trade --concurrency 3 --limit 30 --out logs/code_review_candidates_sunday.md

StandardOutput=journal
StandardError=journal

# Independent of the finisher's 4h budget. 7200 = 2 hours.
TimeoutStartSec=7200

[Install]
WantedBy=multi-user.target
