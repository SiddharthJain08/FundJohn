[Unit]
Description=Nightly (Tue-Fri 21:45 UTC) guarded pit-gap flip check; the script disables this timer once applied

[Timer]
# Persistent=false: a boot must never replay a missed check into the trading day.
OnCalendar=Tue..Fri *-*-* 21:45:00 UTC
Persistent=false
AccuracySec=1min
Unit=openclaw-pit-gap-flip.service

[Install]
WantedBy=timers.target
