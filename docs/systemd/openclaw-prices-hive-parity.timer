[Unit]
Description=Daily (Tue-Sat 17:05 ET) prices hive parity check, after the 16:15 ET collect and dual-write

[Timer]
# Persistent=false: a boot must never replay a missed check into the trading day.
# 17:05 ET, DST-aware (was 21:05 UTC = 17:05 EDT only; after 2026-11-01 it ran at 16:05 EST, BEFORE the collect it verifies)
OnCalendar=Tue..Sat *-*-* 17:05:00 America/New_York
Persistent=false
AccuracySec=1min
Unit=openclaw-prices-hive-parity.service

[Install]
WantedBy=timers.target
