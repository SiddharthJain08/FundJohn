[Unit]
Description=Fire pre-market scan at 09:35 ET (RTH; drains the deferred news-veto exits — 2026-11-25)
Requires=openclaw-premarket-scan@09:35.service

[Timer]
OnCalendar=Mon..Fri *-*-* 09:35:00 America/New_York
Persistent=false
Unit=openclaw-premarket-scan@09:35.service

[Install]
WantedBy=timers.target
