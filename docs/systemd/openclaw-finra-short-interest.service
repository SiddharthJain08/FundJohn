[Unit]
Description=FINRA biweekly consolidated short interest ingest (cdn.finra.org shrt{YYYYMMDD}.csv -> short_interest.parquet)
After=network-online.target
Wants=network-online.target
OnFailure=openclaw-failure-notify@%n.service

[Service]
Type=oneshot
# User=root: matches every data/master/*.parquet writer (all root:root).
User=root
WorkingDirectory=/root/openclaw
EnvironmentFile=/root/openclaw/.env
Environment=PYTHONPATH=/root/openclaw/src
# Default window = last 45 days: at most ~4 candidate settlement dates, each
# 1-3 keyless GETs (403 = not a settlement date / not yet published = INFO;
# the script only exits 1 when the CDN could not be read at all). Settlement
# dates already in the master are skipped without a request. Read the
# COUNTERS in the log (files_fetched/files_unpublished/new_rows), not the rc.
ExecStart=/usr/bin/python3 /root/openclaw/src/ingestion/ingest_finra_short_interest.py
StandardOutput=append:/var/log/openclaw-finra-short-interest.log
StandardError=append:/var/log/openclaw-finra-short-interest.log
# Network-bound, ~2 MB CSV + one duckdb merge (<300 MB RSS) per new file;
# yield to anything live on the 2-core/8 GB box.
Nice=19
# Sizing: a new file is ~1 s fetch + ~2-5 s merge into a ~1.5M-row master; the
# 45-day default window can produce at most 4 of them. 10 min is >10x headroom.
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
