[Unit]
Description=Fire ext-hours stop monitor every 10 min in premarket (04:00-09:30 ET) and after-hours (16:00-20:00 ET)

[Timer]
OnCalendar=Mon..Fri *-*-* 04..09:00/10:00 America/New_York
OnCalendar=Mon..Fri *-*-* 16..19:00/10:00 America/New_York
Persistent=false
Unit=openclaw-afterhours-stop-monitor.service

[Install]
WantedBy=timers.target
