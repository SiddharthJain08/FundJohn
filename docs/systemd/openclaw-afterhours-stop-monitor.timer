[Unit]
Description=Fire stop monitor + exit-fill reporter every 10 min, 04:00-20:00 ET Mon-Fri

[Timer]
# Full trading day (2026-07-21): the tick also runs the exit-fill reporter,
# which must see RTH take-profit/stop fills; the stop-emulation half still
# self-skips while the market is open (the resting GTC OCO owns RTH exits).
OnCalendar=Mon..Fri *-*-* 04..19:00/10:00 America/New_York
Persistent=false
Unit=openclaw-afterhours-stop-monitor.service

[Install]
WantedBy=timers.target
