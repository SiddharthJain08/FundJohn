[Unit]
Description=OpenClaw weekly strategy-weights refresh timer

[Timer]
# 10:00 UTC Sunday = 06:00 ET during EDT, 05:00 ET during EST.
# After MasterMind's Saturday comprehensive-review (18:00 ET) but before
# Monday's first pipeline cycle (10:00 ET).
OnCalendar=Sun *-*-* 10:00:00 UTC
Persistent=true
Unit=openclaw-weekly-strategy-weights.service

[Install]
WantedBy=timers.target
