[Unit]
Description=CBOE vol indices ingestion (VIX/VVIX/VIX9D → vol_indices.parquet)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=claudebot
WorkingDirectory=/root/openclaw
EnvironmentFile=/root/openclaw/.env
Environment=PYTHONPATH=/root/openclaw/src
ExecStart=/usr/bin/python3 /root/openclaw/src/ingestion/ingest_vol_indices.py
StandardOutput=append:/var/log/openclaw-vol-indices.log
StandardError=append:/var/log/openclaw-vol-indices.log
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
