[Unit]
Description=Sunday research CODE — finisher phases 5-8 + MasterMind candidate code-review
After=network-online.target postgresql.service
Wants=network-online.target
PartOf=johnbot.service
OnFailure=openclaw-failure-notify@%n.service

[Service]
Type=oneshot
User=claudebot
Group=claudebot
EnvironmentFile=/root/openclaw/.env
WorkingDirectory=/root/openclaw

# Phase 5-8: reload today's hunted candidates from research_candidates, data-tier
# filter, Tier-A synchronous code+backtest (idempotent — skips strategies already
# in the manifest), Tier-B → STAGING (operator-gated), Tier-C vault notes; then
# flip today's 08:00 ingest row (status='ingest_complete') to 'completed'.
ExecStart=/usr/bin/node /root/openclaw/src/agent/curators/saturday_brain_finisher.js --mark-run-complete

# NEW: MasterMind (Opus) re-examines RECENT candidate implementations (incl. the
# ones just coded above) for IMPLEMENTATION-LOGIC bugs; candidates with <30
# trades get a "bug vs genuinely rare" diagnosis. REPORT-ONLY for now (operator
# decision 2026-06-08: candidate gated auto-apply — apply→re-backtest→keep-if-
# non-regressing — is a separate, backtest-guarded upgrade). Best-effort: the
# leading '-' means a review hiccup does not fail the code run.
ExecStart=-/usr/bin/node /root/openclaw/src/agent/curators/mastermind_code_review.js --state candidate --recent-days 14 --include-low-trade --concurrency 3 --out logs/code_review_candidates_sunday.md

StandardOutput=journal
StandardError=journal

# Tier-A coding runs sequential backtests (heavy strategies can take ~hours; the
# finisher caps Tier-A via --tier-a-cap) plus the Opus candidate review.
# 14400 = 4 hours.
TimeoutStartSec=14400

[Install]
WantedBy=multi-user.target
