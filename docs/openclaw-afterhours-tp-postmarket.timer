[Unit]
Description=Fire ext-hours TP placement Mon-Fri 16:15 America/New_York (postmarket)

[Timer]
# MUST fire AFTER openclaw-stop-reattach (16:10 ET). stop_reattach places the
# GTC OCO/stop that afterhours_tp relies on for downside ("TP only; the RTH GTC
# stop still covers downside"). If this ran first (the 16:05 regression
# 2026-06-16→06-18) its bare day-TIF TP limits made stop_reattach see every
# position as "already covered" and skip the GTC stop entirely → positions went
# naked when the day-TIF TPs expired. Keep this strictly after 16:10.
OnCalendar=Mon..Fri *-*-* 16:15:00 America/New_York
Persistent=true
Unit=openclaw-afterhours-tp-postmarket.service

[Install]
WantedBy=timers.target
