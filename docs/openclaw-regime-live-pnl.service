[Unit]
Description=OpenClaw — nightly regime live PnL rollup
After=docker.service postgresql.service network.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/root/openclaw
EnvironmentFile=/root/openclaw/.env
Environment="PYTHONPATH=/root/openclaw/src"
ExecStart=/usr/bin/python3 -m metrics.regime_live_pnl
StandardOutput=append:/root/openclaw/logs/regime_live_pnl_rollup.log
StandardError=append:/root/openclaw/logs/regime_live_pnl_rollup.log
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
