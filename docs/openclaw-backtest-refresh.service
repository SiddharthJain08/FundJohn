[Unit]
Description=Weekly unified_backtest refresh + eligibility re-derivation
After=network.target postgresql.service

[Service]
Type=oneshot
User=claudebot
Group=claudebot
EnvironmentFile=/root/openclaw/.env
WorkingDirectory=/root/openclaw
ExecStart=/bin/bash /root/openclaw/src/maintenance/refresh_backtests.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=14400

[Install]
WantedBy=multi-user.target
